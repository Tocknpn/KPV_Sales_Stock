{
  "name": "kpv-goldsmith-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "KPV Goldsmith & Retail Inventory - mobile web app (Cloudflare Worker + Supabase)",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:push": "echo Run supabase/schema.sql then supabase/base.sql in the Supabase SQL editor",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
