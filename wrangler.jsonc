{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpv-sales-stock",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    // Deep links (/daily_stock/…, /settings/users) serve index.html; the
    // client router picks the screen. The API always reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // `wrangler deploy` (also in Workers Builds) builds CSS + the JS bundle first;
  // `wrangler dev` runs it at start and again when src/ or public/js/ change.
  // The outputs (public/dist, public/css) are not watched, so a build never
  // triggers another.
  "build": { "command": "npm run build", "watch_dir": ["src", "public/js"] },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_VERSION": "1.0.0",
    "BUILD_DATE": "2026-11-02"
  }
}
